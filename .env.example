# ---------------------------------------------------------------------------
# LANForge Employee Dashboard — environment configuration
# Copy to .env and fill in real values. Do NOT commit .env.
# ---------------------------------------------------------------------------

# Core
NODE_ENV=production
PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string
MONGODB_URI=mongodb+srv://user:pass@cluster/db

# Email (Resend)
RESEND_KEY=

# Orders API (sales goal)
LANFORGE_ORDERS_API_URL=
LANFORGE_ORDERS_API_KEY=

# Rate limiting (optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ---------------------------------------------------------------------------
# Contracts / DocuSeal
# ---------------------------------------------------------------------------
# API key from https://console.docuseal.com  (Settings -> API)
DOCUSEAL_API_KEY=
# Use https://api.docuseal.eu for the EU region; default is the US endpoint.
DOCUSEAL_BASE_URL=https://api.docuseal.com
# Shared secret to verify inbound webhooks. Set the same value in DocuSeal's
# webhook URL as ?secret=... or the X-Docuseal-Secret header.
DOCUSEAL_WEBHOOK_SECRET=
# 32-byte key (64 hex chars) used to encrypt SSN/EIN at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: if this key is lost or changed, previously stored SSN/EIN values
# cannot be decrypted and must be re-entered.
CONTRACT_ENC_KEY=
