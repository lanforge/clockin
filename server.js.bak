      start_date,
      end_date,
      is_active
    } = req.body;
    
    const updatedAnnouncement = await Announcement.findByIdAndUpdate(
      announcementId,
      {
        title,
        content,
        type,
        display_type,
        start_date: start_date ? new Date(start_date) : undefined,
        end_date: end_date ? new Date(end_date) : undefined,
        is_active,
        updated_at: new Date()
      },
      { new: true }
    );
    
    if (!updatedAnnouncement) {
